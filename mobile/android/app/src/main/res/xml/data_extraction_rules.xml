<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: transcript history never leaves the device through cloud backup or device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="history.sqlite" />
        <exclude domain="database" path="history.sqlite-wal" />
        <exclude domain="database" path="history.sqlite-shm" />
        <exclude domain="database" path="history.sqlite-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="history.sqlite" />
        <exclude domain="database" path="history.sqlite-wal" />
        <exclude domain="database" path="history.sqlite-shm" />
        <exclude domain="database" path="history.sqlite-journal" />
    </device-transfer>
</data-extraction-rules>
