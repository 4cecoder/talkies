<Window x:Class="Talkies.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Talkies Windows" Height="650" Width="1050" Background="#1a1a1a" Foreground="White"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left rail -->
        <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock Text="Talkies" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="Real-time transcription" Foreground="#bbbbbb"/>

            <Border Background="#242424" Padding="12" CornerRadius="8">
                <StackPanel>
                    <Button Content="Start" Command="{Binding StartCommand}" IsEnabled="{Binding IsIdle}" Height="36" Margin="0,0,0,6"/>
                    <Button Content="Stop" Command="{Binding StopCommand}" IsEnabled="{Binding IsRecording}" Height="36" Margin="0,0,0,6"/>
                    <Button Content="Save VTT" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" Height="32" Margin="0,0,0,6"/>
                    <Button Content="Clear" Command="{Binding ClearCommand}" Height="32"/>
                </StackPanel>
            </Border>

            <Border Background="#242424" Padding="12" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Model" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" Margin="0,0,0,6"/>
                    <TextBlock Text="Language" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" Margin="0,0,0,6"/>
                    <TextBlock Text="Microphone" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}" DisplayMemberPath="Name" Margin="0,0,0,6"/>
                    <CheckBox Content="Voice Activity Detection" IsChecked="{Binding VadEnabled}" Margin="0,4,0,0"/>
                    <CheckBox Content="Hallucination Filter" IsChecked="{Binding FilterEnabled}" Margin="0,4,0,0"/>
                    <Separator Margin="0,8,0,8"/>
                    <CheckBox Content="Enhance with LLM (Ollama)" IsChecked="{Binding EnhanceEnabled}"/>
                    <TextBlock Text="Ollama URL" FontSize="12" Margin="0,2,0,0"/>
                    <TextBox Text="{Binding OllamaUrl}" Margin="0,0,0,4"/>
                    <TextBlock Text="Ollama Model" FontSize="12" Margin="0,2,0,0"/>
                    <TextBox Text="{Binding OllamaModel}" Margin="0,0,0,4"/>
                    <Separator Margin="0,8,0,8"/>
                    <CheckBox Content="Speak response (TTS)" IsChecked="{Binding TtsEnabled}"/>
                    <CheckBox Content="Insert text after transcription" IsChecked="{Binding InsertEnabled}"/>
                    <TextBlock Text="Backend:" Margin="0,8,0,0"/><TextBlock Text="{Binding Backend}" Foreground="#66b3ff" />
                    <TextBlock Text="Elapsed:" Margin="0,4,0,0"/><TextBlock Text="{Binding ElapsedText}" />
                </StackPanel>
            </Border>

            <Border Background="#242424" Padding="12" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Segments: {Binding SegmentCount}" />
                    <TextBlock Text="Words: {Binding WordCount}" />
                    <TextBlock Text="WPM: {Binding WordsPerMinute}" />
                </StackPanel>
            </Border>

            <Border Background="#242424" Padding="12" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Hotkey" FontWeight="SemiBold" />
                    <TextBlock Text="Right Alt tap = toggle, hold = push-to-talk" FontSize="12" Foreground="#bbbbbb" />
                    <TextBlock Text="Status: {Binding HotkeyStatus}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Right panel -->
        <Border Grid.Column="1" Background="#1f1f1f" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Margin="8" LastChildFill="False">
                    <TextBlock Text="Live Transcript" FontSize="20" FontWeight="Bold" DockPanel.Dock="Left" />
                    <Button Content="Export" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" Height="28" Margin="8,0" DockPanel.Dock="Right" />
                </DockPanel>

                <Border Grid.Row="1" Margin="8" Background="#252525" CornerRadius="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Segments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#2d2d2d" CornerRadius="6" Padding="10" Margin="8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Timestamp}" FontFamily="Consolas" Foreground="#66b3ff" />
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
