<Window x:Class="Talkies.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Talkies.Windows.Controls"
        Title="Talkies Windows"
        Height="700" Width="1200"
        MinHeight="600" MinWidth="900"
        Background="{DynamicResource PrimaryBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="300" />
            <ColumnDefinition Width="*" MinWidth="500" />
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar -->
        <ScrollViewer Grid.Column="0" Margin="0,0,12,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Header -->
                <TextBlock Text="Talkies" FontSize="28" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBlock Text="Real-time transcription" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,12"/>

                <!-- Waveform Visualizer -->
                <TextBlock Text="Audio Input" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <local:WaveformVisualizer x:Name="WaveformVisualizer" Margin="0,0,0,12" />

                <!-- Recording Controls -->
                <Border Background="{DynamicResource TertiaryBackgroundBrush}" Padding="12" CornerRadius="8" Margin="0,0,0,12">
                    <StackPanel>
                        <Button Content="Start Recording" Command="{Binding StartCommand}" IsEnabled="{Binding IsIdle}" Height="40" Margin="0,0,0,8" FontSize="13" FontWeight="SemiBold"/>
                        <Button Content="Stop Recording" Command="{Binding StopCommand}" IsEnabled="{Binding IsRecording}" Height="40" Margin="0,0,0,8" FontSize="13" FontWeight="SemiBold"/>
                        <Button Content="Save VTT" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" Height="36" Margin="0,0,0,6"/>
                        <Button Content="Clear" Command="{Binding ClearCommand}" Height="36"/>
                    </StackPanel>
                </Border>

                <!-- Transcription Settings -->
                <Border Background="{DynamicResource TertiaryBackgroundBrush}" Padding="12" CornerRadius="8" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Transcription Settings" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>

                        <TextBlock Text="Model" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" Margin="0,0,0,8" Height="32" Padding="8,6"/>

                        <TextBlock Text="Language" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" Margin="0,0,0,8" Height="32" Padding="8,6"/>

                        <TextBlock Text="Input Source" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}" DisplayMemberPath="Name" Margin="0,0,0,8" Height="32" Padding="8,6"/>

                        <CheckBox Content="Voice Activity Detection" IsChecked="{Binding VadEnabled}" Margin="0,6,0,6" FontSize="11"/>
                        <CheckBox Content="Hallucination Filter" IsChecked="{Binding FilterEnabled}" Margin="0,0,0,0" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- LLM Enhancement Settings -->
                <Border Background="{DynamicResource TertiaryBackgroundBrush}" Padding="12" CornerRadius="8" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="LLM Enhancement" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>

                        <CheckBox Content="Enable LLM Enhancement" IsChecked="{Binding EnhanceEnabled}" Margin="0,0,0,10" FontSize="11"/>

                        <TextBlock Text="Provider" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4" Visibility="{Binding EnhanceEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ComboBox ItemsSource="{Binding LlmProviders}" SelectedItem="{Binding SelectedLlmProvider}" Margin="0,0,0,8" Height="32" Padding="8,6" Visibility="{Binding EnhanceEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <TextBlock Text="Endpoint" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4" Visibility="{Binding EnhanceEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBox Text="{Binding LlmEndpoint, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" Height="32" Padding="8,6" Visibility="{Binding EnhanceEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <Button Content="Fetch Models" Command="{Binding FetchModelsCommand}" IsEnabled="{Binding IsFetchingModels, Converter={StaticResource BooleanInverterConverter}}" Height="32" Margin="0,0,0,8" Visibility="{Binding EnhanceEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <TextBlock Text="Model" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4" Visibility="{Binding EnhanceEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ComboBox ItemsSource="{Binding AvailableLlmModels}" SelectedItem="{Binding SelectedLlmModel}" DisplayMemberPath="DisplayName" Margin="0,0,0,8" Height="32" Padding="8,6" Visibility="{Binding EnhanceEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <TextBlock Text="Enhancement Mode" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4" Visibility="{Binding EnhanceEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ComboBox ItemsSource="{Binding EnhancementModes}" SelectedItem="{Binding SelectedEnhancementMode}" Margin="0,0,0,8" Height="32" Padding="8,6" Visibility="{Binding EnhanceEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <TextBlock Text="Custom Mode Name" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4" Visibility="{Binding EnhanceEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBox Text="{Binding NewPromptName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" Height="28" Padding="8,4" Visibility="{Binding EnhanceEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <TextBlock Text="System Prompt" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4" Visibility="{Binding EnhanceEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBox Text="{Binding NewPromptText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,8" Height="100" Padding="8,6" VerticalScrollBarVisibility="Auto" Visibility="{Binding EnhanceEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <Button Content="Save Prompt as Mode" Command="{Binding SavePromptCommand}" Height="32" Margin="0,0,0,0" Visibility="{Binding EnhanceEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <!-- Theme Settings -->
                <Border Background="{DynamicResource TertiaryBackgroundBrush}" Padding="12" CornerRadius="8" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>

                        <TextBlock Text="Theme" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" Margin="0,0,0,8" Height="32" Padding="8,6"/>
                    </StackPanel>
                </Border>

                <!-- Additional Features -->
                <Border Background="{DynamicResource TertiaryBackgroundBrush}" Padding="12" CornerRadius="8" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Additional Features" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>
                        <CheckBox Content="Speak response (TTS)" IsChecked="{Binding TtsEnabled}" Margin="0,6,0,6" FontSize="11"/>
                        <CheckBox Content="Insert text after transcription" IsChecked="{Binding InsertEnabled}" Margin="0,0,0,0" FontSize="11"/>

                        <Button Content="Manage Plugins" Command="{Binding ShowPluginsCommand}" Height="32" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Right Content Area -->
        <Border Grid.Column="1" Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header Bar -->
                <DockPanel Margin="12,12,12,8" LastChildFill="False">
                    <TextBlock Text="Live Transcript" FontSize="22" FontWeight="Bold" DockPanel.Dock="Left" />
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="0,0,0,0">
                        <Button Content="Export SRT" Command="{Binding ExportSrtCommand}" IsEnabled="{Binding CanSave}" Height="32" Margin="0,0,8,0" Padding="12,0"/>
                        <Button Content="Export TXT" Command="{Binding ExportTxtCommand}" IsEnabled="{Binding CanSave}" Height="32" Margin="0,0,8,0" Padding="12,0"/>
                        <Button Content="Export VTT" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" Height="32" Padding="12,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- Transcript Display -->
                <Border Grid.Row="1" Margin="12,8,12,12" Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                            <ItemsControl ItemsSource="{Binding Segments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SegmentBackgroundBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8" BorderThickness="0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Timestamp}" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,0,12,0" MinWidth="90" VerticalAlignment="Top"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" LineHeight="18" Foreground="{DynamicResource PrimaryTextBrush}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Row="1" Background="{DynamicResource ErrorBackgroundBrush}" BorderBrush="{DynamicResource ErrorBorderBrush}" BorderThickness="1" CornerRadius="0,0,6,6" Padding="10"
                                Visibility="{Binding HasErrors, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Issues" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ErrorTextBrush}" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding ErrorMessages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorTextBrush}" FontSize="11" Margin="0,0,0,4"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Footer: status + stats + hotkey spanning full width -->
                <Grid Grid.Row="2" Margin="12,0,12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource TertiaryBackgroundBrush}" Padding="12" CornerRadius="8" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Status" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                            <TextBlock Text="Backend:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding Backend}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="Elapsed:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding ElapsedText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="Hotkey Status:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding HotkeyStatus}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{DynamicResource TertiaryBackgroundBrush}" Padding="12" CornerRadius="8" Margin="4,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Transcript Statistics" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Segments" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10"/>
                                    <TextBlock Text="{Binding SegmentCount}" Foreground="{DynamicResource AccentBrush}" FontSize="14" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                    <TextBlock Text="Words" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10"/>
                                    <TextBlock Text="{Binding WordCount}" Foreground="{DynamicResource AccentBrush}" FontSize="14" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                    <TextBlock Text="WPM" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10"/>
                                    <TextBlock Text="{Binding WordsPerMinute}" Foreground="{DynamicResource AccentBrush}" FontSize="14" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{DynamicResource SegmentBackgroundBrush}" Padding="12" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Hotkey" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                            <TextBlock Text="Right Alt" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,0,0,2"/>
                            <TextBlock Text="Tap: Start/Stop | Hold: Push-to-talk" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Busy Overlay -->
        <Grid Grid.ColumnSpan="2"
              Background="{DynamicResource OverlayBrush}"
              Visibility="{Binding ShowOverlay, Converter={StaticResource BooleanToVisibilityConverter}}"
              Panel.ZIndex="10">
            <Border Width="420" Padding="20" Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource DropShadowEffect}">
                <StackPanel>
                    <TextBlock Text="{Binding OverlayTitle}" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding OverlayMessage}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                    <ProgressBar Minimum="0" Maximum="100"
                                 Value="{Binding OverlayProgress}"
                                 IsIndeterminate="{Binding OverlayIsIndeterminate}"
                                 Height="14"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
