<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Talkies.Windows.Views.PluginsManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Plugins" Height="500" Width="700"
        MinHeight="400" MinWidth="600"
        Background="#1a1a1a" Foreground="White"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Plugin Manager" FontSize="24" FontWeight="Bold" Margin="0,0,0,12"/>

        <!-- Plugins List -->
        <Border Grid.Row="1" Background="#1f1f1f" CornerRadius="8" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Plugins}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#242424" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Plugin Info -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>

                                        <TextBlock Text="{Binding Description}" Foreground="#999999" FontSize="12" Margin="0,0,0,8"/>

                                        <!-- Advanced TTS settings -->
                                        <StackPanel Visibility="{Binding IsAdvancedTts, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,4,0,4">
                                            <TextBlock Text="Voice" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding Voices}"
                                                      SelectedItem="{Binding SelectedVoice}"
                                                      Height="28"
                                                      Padding="8,4"
                                                      Margin="0,0,0,8"/>

                                            <TextBlock Text="Speed" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                                <Slider Minimum="-10" Maximum="10" Value="{Binding Rate, UpdateSourceTrigger=PropertyChanged}" Width="180" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                                <TextBlock Text="{Binding Rate}" FontSize="10" Foreground="#cccccc" Margin="6,0,0,0"/>
                                            </StackPanel>

                                            <TextBlock Text="Pitch" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                                <Slider Minimum="-20" Maximum="20" Value="{Binding Pitch, UpdateSourceTrigger=PropertyChanged}" Width="180" TickFrequency="2" IsSnapToTickEnabled="True"/>
                                                <TextBlock Text="{Binding Pitch}" FontSize="10" Foreground="#cccccc" Margin="6,0,0,0"/>
                                            </StackPanel>

                                            <TextBlock Text="Volume" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Slider Minimum="0" Maximum="100" Value="{Binding Volume, UpdateSourceTrigger=PropertyChanged}" Width="180" TickFrequency="5" IsSnapToTickEnabled="True"/>
                                                <TextBlock Text="{Binding Volume}" FontSize="10" Foreground="#cccccc" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Status -->
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="Status:" Foreground="#66b3ff" FontSize="11"/>
                                            <TextBlock Text="{Binding Status}" Foreground="#66b3ff" FontSize="12" FontWeight="SemiBold" Margin="4,0,8,0"/>
                                        </StackPanel>

                                        <!-- Enable/Disable Toggle -->
                                        <CheckBox Content="Enabled" IsChecked="{Binding IsEnabled}"
                                                 VerticalAlignment="Center" Margin="0,8,0,0"
                                                 Foreground="White"/>

                                        <!-- Settings Button (if available) -->
                                        <Button Content="Configure" Command="{Binding ConfigureCommand}"
                                                Visibility="{Binding HasSettings, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Height="24" Margin="0,12,0,0" FontSize="11"/>
                                    </StackPanel>

                                    <!-- Icon -->
                                    <Grid Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                                        <Ellipse Width="36" Height="36" Fill="#333333"/>
                                        <TextBlock Text="{Binding Icon}" FontSize="20"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Command="{Binding CloseCommand}" Height="32" Width="80"
                    Padding="16,0" Margin="0,0,8,0"/>
        </StackPanel>
    </Grid>
</Window>
