<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Talkies.Windows.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transcript History" Height="600" Width="760"
        MinHeight="400" MinWidth="560"
        Background="#1a1a1a" Foreground="White"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Transcript History" FontSize="24" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="Saved on this PC only. Newest first." Foreground="#bbbbbb" FontSize="12"/>
        </StackPanel>

        <!-- Search -->
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <Button Content="Clear All…" Command="{Binding ClearAllCommand}" DockPanel.Dock="Right" Height="32" Padding="12,0" Margin="8,0,0,0"
                    AutomationProperties.Name="Clear all transcript history"/>
            <TextBlock Text="Search" DockPanel.Dock="Left" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,0"/>
            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" Height="32" Padding="8,6" VerticalContentAlignment="Center"
                     AutomationProperties.Name="Search transcripts"/>
        </DockPanel>

        <!-- Transcripts -->
        <Border Grid.Row="2" Background="#1f1f1f" CornerRadius="8" Padding="8">
            <Grid>
                <ScrollViewer x:Name="ResultsScroller" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#2d2d2d" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Details}" Foreground="#999999" FontSize="11" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                                     Background="Transparent" BorderThickness="0" Foreground="White" FontSize="13" Padding="0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                            <Button Content="Copy" Height="26" Padding="10,0" Margin="0,0,6,0" FontSize="11"
                                                    Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="Copy transcript"/>
                                            <Button Content="Delete" Height="26" Padding="10,0" FontSize="11"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="Delete transcript"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="{Binding Status}" Foreground="#999999" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="{Binding Status}" Foreground="#bbbbbb" FontSize="11" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Close" Click="Close_Click" Height="32" Width="80" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="Next ›" Command="{Binding NextPageCommand}" Height="32" Padding="12,0" Margin="8,0,0,0"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding PageLabel}" Foreground="#bbbbbb" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="‹ Previous" Command="{Binding PreviousPageCommand}" Height="32" Padding="12,0"/>
        </DockPanel>
    </Grid>
</Window>
