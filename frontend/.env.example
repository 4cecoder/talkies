# Stripe Configuration
# Get your keys from https://dashboard.stripe.com/apikeys

# Public key (safe to expose to client)
NEXT_PUBLIC_STRIPE_KEY=pk_test_your_publishable_key_here

# Secret key (keep secure, never commit actual key)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Webhook secret (get from Stripe webhook settings)
# https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Price IDs (create products in Stripe Dashboard)
# https://dashboard.stripe.com/products
NEXT_PUBLIC_STRIPE_MONTHLY_PRICE_ID=price_monthly_id_here
NEXT_PUBLIC_STRIPE_YEARLY_PRICE_ID=price_yearly_id_here

# Development notes:
# 1. Create a Stripe account at https://stripe.com
# 2. Get your API keys from the dashboard
# 3. Create two products with recurring prices:
#    - Monthly: $10/month
#    - Yearly: $96/year
# 4. Copy the price IDs to this file
# 5. Set up webhook endpoint in Stripe to point to:
#    https://yourdomain.com/api/webhook
# 6. Select these events for the webhook:
#    - checkout.session.completed
#    - customer.subscription.created
#    - customer.subscription.updated
#    - customer.subscription.deleted
#    - invoice.payment_succeeded
#    - invoice.payment_failed
