# ================================
# SECURITY NOTICE
# ================================
# NEVER commit .env.local to git!
# Copy this file to .env.local and fill in your actual values
#
# IMPORTANT: If secrets were previously exposed in git:
# 1. Rotate ALL keys immediately
# 2. Use new keys in .env.local
# 3. Never reuse exposed credentials

# ================================
# Vercel (for local development)
# ================================
VERCEL_OIDC_TOKEN="your-vercel-oidc-token-here"

# ================================
# Convex (Backend as a Service)
# ================================
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# ================================
# Stripe (Payments)
# ================================
# Get these from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Get this from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs (create products/prices in Stripe Dashboard)
STRIPE_PRICE_ID_PRO_MONTHLY=price_your_monthly_price_id
STRIPE_PRICE_ID_PRO_ANNUAL=price_your_annual_price_id

# ================================
# BetterAuth (Authentication)
# ================================
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-better-auth-secret-min-32-chars"

# Your application URL (change in production)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
