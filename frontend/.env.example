# ===========================================
# Convex Configuration
# ===========================================
# Get these from running `npx convex dev`

# Convex deployment URL (automatically set by Convex CLI)
CONVEX_DEPLOYMENT=dev:your-deployment-name

# Public Convex URL for client-side
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Convex site URL (same as above but with .site suffix)
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# ===========================================
# Better Auth Configuration
# ===========================================

# Auth secret for encryption and token generation
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-32-character-secret-here

# ===========================================
# Site Configuration
# ===========================================

# Site URL (for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===========================================
# Stripe Configuration
# ===========================================
# Get your keys from https://dashboard.stripe.com/apikeys

# Public key (safe to expose to client)
NEXT_PUBLIC_STRIPE_KEY=pk_test_your_publishable_key_here

# Secret key (keep secure, never commit actual key)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Webhook secret (get from Stripe webhook settings)
# https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Price IDs (create products in Stripe Dashboard)
# https://dashboard.stripe.com/products
NEXT_PUBLIC_STRIPE_MONTHLY_PRICE_ID=price_monthly_id_here
NEXT_PUBLIC_STRIPE_YEARLY_PRICE_ID=price_yearly_id_here

# ===========================================
# Development Setup Guide
# ===========================================
#
# 1. CONVEX SETUP:
#    a. Install Convex CLI: npm install convex
#    b. Run: npx convex dev
#    c. Follow the prompts to create/link a project
#    d. Copy the deployment URLs from the CLI output
#
# 2. BETTER AUTH SETUP:
#    a. Generate a secret: openssl rand -base64 32
#    b. Set BETTER_AUTH_SECRET in this file
#
# 3. STRIPE SETUP:
#    a. Create a Stripe account at https://stripe.com
#    b. Get your API keys from the dashboard
#    c. Create two products with recurring prices:
#       - Monthly: $10/month
#       - Yearly: $96/year
#    d. Copy the price IDs to this file
#    e. Set up webhook endpoint in Stripe to point to:
#       https://yourdomain.com/api/webhook
#    f. Select these events for the webhook:
#       - checkout.session.completed
#       - customer.subscription.created
#       - customer.subscription.updated
#       - customer.subscription.deleted
#       - invoice.payment_succeeded
#       - invoice.payment_failed
